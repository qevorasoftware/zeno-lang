{
  "spec_version": "0.1.0",
  "grammar_version": "v0.1",
  "protocol": "zeno",
  "description": "Machine-readable token table for the Zeno Protocol Grammar v0.1. This file is the single source of truth for sigils, operators, delimiters and keyword literals. zeno/spec.py loads it and tests/test_spec.py asserts that the implementation agrees with it.",
  "sigils": [
    {
      "token": "@",
      "name": "TARGET",
      "role": "Target / Scope",
      "meaning": "Defines context, entity, location, or system target.",
      "example": "@LOC[AMD] @AGENT[Coder]",
      "scope_kinds": [
        "AGENT",
        "LOC",
        "ORG",
        "SYS",
        "USER",
        "TIME",
        "CTX",
        "ANY"
      ]
    },
    {
      "token": "?",
      "name": "QUERY",
      "role": "Query / Input",
      "meaning": "Requests information or fetches state.",
      "example": "?WEATHER ?USER_NAME ?WX"
    },
    {
      "token": "!",
      "name": "ACTION",
      "role": "Action / Output",
      "meaning": "Executes an action or generates output.",
      "example": "!GEN[Report] !RUN[Script]"
    },
    {
      "token": "$",
      "name": "VARIABLE",
      "role": "Variable",
      "meaning": "References a stored latent state or variable. Supports property paths.",
      "example": "$PRICE $TEMP $WX.state"
    }
  ],
  "flow_operators": [
    {
      "token": "->",
      "name": "ARROW",
      "role": "Pipeline / Flow",
      "meaning": "Passes the output of the left operation to the right operation.",
      "precedence": null,
      "associativity": "left"
    },
    {
      "token": ":",
      "name": "COLON",
      "role": "Evaluator",
      "meaning": "Begins a conditional evaluation block.",
      "precedence": null,
      "associativity": null
    },
    {
      "token": "=>",
      "name": "THEN",
      "role": "Then (Implies)",
      "meaning": "Action to take if the condition evaluates to true.",
      "precedence": null,
      "associativity": null
    },
    {
      "token": "|",
      "name": "ELSE",
      "role": "Else",
      "meaning": "Action to take if the condition evaluates to false. Also the separator between branches of a conditional.",
      "precedence": null,
      "associativity": null
    }
  ],
